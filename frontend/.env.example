# Copy to frontend/.env.local
# Backend URL. Leave empty in dev (Vite proxies /api to localhost:8080).
VITE_API_BASE=
# Browser Maps JavaScript API key (restrict it to your domains). Without it, a schematic map is shown.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID with Advanced Markers enabled (Cloud Console → Map management)
VITE_GOOGLE_MAP_ID=
