# Copy to backend/.env and fill in. Never commit .env.

# true = offline fixtures, no Google Cloud needed. false = live Gemini / Maps.
MOCK_MODE=true

# Google Cloud
GCP_PROJECT=your-project-id
GCP_LOCATION=us-central1
GCS_BUCKET=your-project-id-kintsugi-uploads

# memory (default) or firestore
STORE=memory
FIRESTORE_DATABASE=(default)

# Confirm the latest model IDs in Vertex AI Model Garden
MODEL_REASONING=gemini-2.5-pro
MODEL_FAST=gemini-2.5-flash
MODEL_IMAGE=gemini-2.5-flash-image
MODEL_EMBEDDING=gemini-embedding-2-preview
EMBEDDING_DIM=768

# Server-side Maps key (Geocoding API + Places API (New))
MAPS_API_KEY=

DEMO_STEP_DELAY=0.6
SEARCH_RADIUS_KM=15
CORS_ORIGINS=*

# For `adk web`
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
